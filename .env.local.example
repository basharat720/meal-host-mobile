# Copy this file to .env.local and fill in your values.
# Use your Mac's LAN IP for BACKEND_API_URL so the phone can reach it.
# Find your LAN IP: ipconfig getifaddr en0

EXPO_PUBLIC_BACKEND_API_URL=http://192.168.x.x:8000

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional overrides — Google Sign-In client IDs default to the real
# mealhost-dev ones in src/constants/config.ts. Needs a native build (not Expo Go).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Facebook sign-in (Meta app). Leave blank to hide "Continue with Facebook".
# Both are baked into the app (not secret). Re-run prebuild after changing.
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=

# Google Places (New) + Geocoding API key, for address search and "Locate me"
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
