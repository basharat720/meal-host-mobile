# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Firebase service account (never commit)
firebase-service-account.json
*-service-account.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local build/ship scripts (contain project config, kept out of git)
/scripts

# local preview builds
*.apk
*.aab

# Play Store listing images (screenshots, raw captures, icon, feature graphic).
# Kept locally only; raw captures can contain personal data.
playstore-listing/**/*.png
playstore-listing/**/*.jpg
playstore-listing/**/*.jpeg
playstore-listing/**/*.webp
