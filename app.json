{
  "expo": {
    "name": "FoodPal",
    "slug": "meal-host-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "foodpal",
      "mealhost"
    ],
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mealhost.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "11"
    },
    "android": {
      "package": "com.mealhost.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0003D5",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/foodpal-lockup-white.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#0003D5"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to show the home kitchens nearest to you, sort them by distance, and check that your delivery address is inside the area we deliver to. It is never used while the app is closed.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Your photo library is opened only when you choose a picture for your profile or for a dish on your menu.",
          "cameraPermission": "Your camera is used only when you take a picture for your profile or for a dish on your menu.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0003D5"
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c1b4d665-1386-4de1-a1a7-a01e6d9b9360"
      },
      "router": {}
    },
    "owner": "waseemkhan01"
  }
}
